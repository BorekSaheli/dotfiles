#!/usr/bin/env sh

# Cross-platform pre-push hook managed by chezmoi.
# Validates all commit messages in push range. Silent on success.

set -eu

# Source shared git-rules
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
. "$SCRIPT_DIR/git-rules"

check_commit() {
	sha="$1"
	subject="$(git show -s --format=%s "$sha")"
	validate_commit_subject "$subject" "$sha"
}

while read -r local_ref local_sha remote_ref remote_sha; do
	[ -z "$local_ref" ] && continue

	# Deletions have all-zero local SHA; skip.
	if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
		continue
	fi

	if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
		range="$local_sha"
	else
		range="$remote_sha..$local_sha"
	fi

	for commit in $(git rev-list "$range" 2>/dev/null); do
		check_commit "$commit" || exit 1
	done
done
