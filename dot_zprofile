# ~/.zprofile — login-shell environment (sourced once). Interactive stuff goes in .zshrc.

# Homebrew (macOS) first so its python/tools win over system ones.
[[ -d /opt/homebrew/bin ]] && export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"

# User binaries (pipx, cargo, uv, claude, ...).
export PATH="$HOME/.local/bin:$HOME/bin:$PATH"
